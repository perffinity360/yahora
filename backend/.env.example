PORT=5000

# The backend and local Supabase run on the SAME machine, so this is always
# loopback. Never a LAN IP: when the DHCP lease changes, every backend->Supabase
# call dies with ConnectTimeoutError / EHOSTDOWN and /api/auth/request-otp 500s.
#
# Devices on the LAN do not read this value. The Expo app resolves the dev host
# at runtime (mobile/src/lib/config.ts) and the web app uses the Vite /supabase
# proxy, so nothing here changes when the Wi-Fi address does.
#
# In production this is the hosted https://<project>.supabase.co origin.
SUPABASE_URL=http://127.0.0.1:54321

# From `supabase status`. Never commit the real values.
SUPABASE_ANON_KEY=<local anon key>
SUPABASE_SERVICE_ROLE_KEY=<local service_role key>

# Must be set to `production` on a real deploy. CORS branches on it: without it
# the server applies the development origin rules and rejects the hosted
# frontend. Leave it unset locally.
# NODE_ENV=production
