# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_,
# and it INLINES them at build time — restart the dev server after any edit.
#
# ⚠ No trailing spaces and no trailing slash on a URL. Both have broken this
#    project before. See CLAUDE.md §10 and §17.

# ── Supabase ────────────────────────────────────────────────────────────────
# Left EMPTY on purpose in local dev: the browser resolves this URL itself, so
# a 127.0.0.1 here means "the visitor's own laptop" and breaks realtime,
# presence, the unread badge and storage for every device on the LAN except the
# one running the servers. Empty makes supabaseClient.js fall back to the
# /supabase proxy on the serving origin (see vite.config.js). Set a full origin
# only for production/hosted builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=<local anon key from `supabase status`>

# ── Backend ─────────────────────────────────────────────────────────────────
# Left EMPTY on purpose, same reasoning. The code builds `${VITE_API_BASE_URL}/api/...`,
# so an empty value yields relative /api/... URLs that the Vite dev proxy
# forwards to the backend — works from any device on the LAN with no IP to
# update. NO trailing /api: the code appends it.
VITE_API_BASE_URL=

# Which port YOUR Express backend listens on. Read by the Vite dev server for
# the /api proxy (see vite.config.js), not by the browser.
#
# 5000 is the default and what the backend uses out of the box — leave this
# unset or at 5000 unless you have a reason not to.
#
# ⚠ Two developers running a backend on the SAME machine must not share a port.
#   The second one starts their backend on another port (e.g. 5001) and sets it
#   here, otherwise their /api calls are proxied to the first developer's server
#   and quietly read and write the wrong database.
VITE_API_PORT=5000

# Which port YOUR Vite dev server listens on. Read by vite.config.js in Node,
# not by the browser.
#
# 3000 is the default — leave this unset or at 3000 unless you have a reason
# not to.
#
# ⚠ Two developers on the SAME machine (separate macOS accounts) cannot share
#   this port. strictPort is on, so the second one to start gets
#   "Port 3000 is already in use" and no server at all. The second developer
#   picks their own port here (e.g. 3001). strictPort stays on deliberately: a
#   silent slide to the next free port would hand you a URL that is really the
#   other developer's app.
VITE_DEV_PORT=3000

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# The SITEKEY only, and it is public by design — it names the widget and
# nothing else. The matching SECRET key is server-side, belongs to Supabase
# (locally: the root .env, wired in via supabase/config.toml), and must NEVER
# appear anywhere in this package. If you find yourself wanting an env var for
# a secret key here, stop — the flow has been misunderstood.
#
# 1x00000000000000000000AA is Cloudflare's "always passes" DUMMY sitekey and is
# for LOCAL DEVELOPMENT ONLY. It pairs with the dummy secret key already
# configured in local Supabase (see docs/CHANGELOG.md, Handoff A).
#
# ⚠ Dummy and real keys only work as a matching PAIR. A real sitekey checked
#   against a dummy secret is rejected every time, and so is the reverse. If
#   local login starts failing for no visible reason, check this first.
#
# PRODUCTION uses the REAL sitekey from the Cloudflare dashboard (ask
# Vishwajeet). It does not allow `localhost` as a hostname, so it cannot stand
# in for the dummy key during local development.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
