# Backend base URL.
# Leave UNSET for local development — the app auto-detects your machine's LAN IP
# from the Expo dev server (so a changing Wi-Fi IP needs no edits here). Set it
# only for production/staging builds, or to force a specific host.
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# Optional: backend port used with the auto-detected dev host (defaults to 5000).
# EXPO_PUBLIC_API_PORT=5000

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
