# No LAN IP belongs in this file. In local dev leave the two URLs UNSET: the app
# reads the Expo dev server's host at runtime (src/lib/config.ts) and pairs it
# with port 5000 for the API and 54321 for Supabase, so a new Wi-Fi address
# needs no edit here.
#
# Set them ONLY for production/staging or to force a specific host. Both are
# then used verbatim.
# EXPO_PUBLIC_API_URL=https://api.yahora.example
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Backend port paired with the auto-detected dev host. Defaults to 5000.
# EXPO_PUBLIC_API_PORT=5000

EXPO_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
